# --- Домен и инфраструктура ---
PUBLIC_DOMAIN=remit.su
PUBLIC_ADDR=remit.su
REMIT_ID_SERVER=remit.su:21116
REMIT_RELAY_SERVER=remit.su:21117
REMIT_API_SERVER=https://remit.su
# Публичный ключ hbbs: /opt/remit/data/rustdesk/id_ed25519.pub
RUSTDESK_PUBLIC_KEY=

# --- Контакты ---
REMIT_SUPPORT_URL=https://t.me/Mrdikpic
REMIT_SUPPORT_EMAIL=support@remit.su
REMIT_SALES_EMAIL=sales@remit.su
REMIT_CITY=Москва

# --- Поиск и аналитика ---
# Яндекс.Вебмастер -> Настройки -> Права доступа (значение мета-тега)
REMIT_YANDEX_VERIFICATION=
# Google Search Console -> Способ с HTML-тегом (значение content)
REMIT_GOOGLE_VERIFICATION=
# Номер счётчика Яндекс.Метрики; пусто — счётчик не подключается
REMIT_YANDEX_METRIKA_ID=

# --- Пробный период для компаний ---
REMIT_TRIAL_MAX_DAYS=30
REMIT_TRIAL_DEFAULT_DAYS=14
REMIT_TRIAL_PLAN=pro

# --- Уведомления о заявках ---
# Бот создаётся у @BotFather, chat_id узнаётся через @userinfobot
REMIT_TELEGRAM_BOT_TOKEN=
REMIT_TELEGRAM_CHAT_ID=

# --- Админка ---
# Почты, которым админка доступна всегда (через запятую). Нужны, чтобы войти
# в неё сразу после установки; дальше роли выдаются из самой админки.
REMIT_ADMIN_EMAILS=

# --- Секреты (сгенерируйте: openssl rand -hex 32) ---
REMIT_AUTH_SECRET=
REMIT_SERVICE_TOKEN=
JWT_KEY=

# --- Хранилище сборок клиента ---
# Каталог, куда админка складывает загруженные файлы обновлений
REMIT_RELEASES_DIR=/app/data/releases
# Предел размера одного файла (по умолчанию 1 ГБ)
REMIT_MAX_UPLOAD_BYTES=1073741824
# Необязательно: внешнее хранилище, если сборки лежат не на сервере
REMIT_DOWNLOADS_BASE=

# --- База данных ---
POSTGRES_DB=remit
POSTGRES_USER=remit
POSTGRES_PASSWORD=
DATABASE_URL=postgres://remit:пароль@db:5432/remit

# --- Тарификация ---
# 3 часа в сутки = 10800 секунд
REMIT_FREE_SECONDS_PER_DAY=10800
REMIT_TZ=Europe/Moscow

# --- RustDesk ---
# Своя сборка образа: ghcr.io/anathom1a/rustdesk-server-s6-remit:latest
# Образ сервера. По умолчанию — публичный, без проверки суточного лимита.
# Свой образ с лимитом: sudo bash server/build-image.sh (см. docs/DEPLOY.md)
# RUSTDESK_IMAGE=remit/rustdesk-server-s6:latest
RUSTDESK_IMAGE=lejianwen/rustdesk-server-s6:latest
MUST_LOGIN=N
TOKEN_EXPIRE=720h

# --- Оплата: ЮKassa ---
# yookassa — приём карт и СБП; manual — резервный режим (счёт подтверждает администратор)
REMIT_BILLING_PROVIDER=yookassa
# Личный кабинет ЮKassa -> Интеграция -> Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa возвращает клиента после оплаты
YOOKASSA_RETURN_URL=https://remit.su/kabinet/podpiska
# В ЮKassa (Интеграция -> HTTP-уведомления) укажите:
#   https://remit.su/api/v1/billing/webhook/yookassa
# и включите события payment.succeeded и payment.canceled
