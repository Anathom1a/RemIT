# --- Домен и инфраструктура ---
PUBLIC_DOMAIN=remit.su
PUBLIC_ADDR=remit.su
REMIT_ID_SERVER=remit.su:21116
REMIT_RELAY_SERVER=remit.su:21117
REMIT_API_SERVER=https://remit.su
# Публичный ключ hbbs: /opt/remit/data/rustdesk/id_ed25519.pub
RUSTDESK_PUBLIC_KEY=

# --- Контакты ---
# Официальный канал обращений: форма в кабинете
REMIT_SUPPORT_URL=https://remit.su/kabinet/podderzhka
# Официальный бот поддержки; пусто — не показываем
REMIT_SUPPORT_BOT_URL=
REMIT_SUPPORT_EMAIL=support@remit.su
REMIT_SALES_EMAIL=sales@remit.su
REMIT_CITY=Москва

# --- Почта для писем пользователям (восстановление пароля) ---
# Любой SMTP: почта на домене (Яндекс 360: smtp.yandex.ru, 465), Mail.ru для
# бизнеса (smtp.mail.ru, 465) или сервис рассылок. Пусто — письма не уходят.
REMIT_SMTP_HOST=
REMIT_SMTP_PORT=465
# true — TLS сразу (порт 465), false — STARTTLS (порт 587)
REMIT_SMTP_SECURE=true
REMIT_SMTP_USER=noreply@remit.su
# Для Яндекса и Mail.ru — пароль приложения, а не пароль от ящика
REMIT_SMTP_PASSWORD=
REMIT_MAIL_FROM=RemIT <noreply@remit.su>

# --- Реквизиты для оферты и политики обработки данных ---
# Пустое поле на сайте не выводится; что не заполнено — видно на главной админки
REMIT_LEGAL_NAME=
REMIT_LEGAL_INN=
REMIT_LEGAL_OGRN=
REMIT_LEGAL_ADDRESS=
REMIT_LEGAL_BANK=
REMIT_LEGAL_PHONE=
# true — документы проверены юристом, напоминание в админке пропадёт
REMIT_LEGAL_REVIEWED=
# Исходный код сборки клиента (требование AGPL-3.0)
REMIT_CLIENT_SOURCE_URL=https://github.com/Anathom1a/rustdesk/tree/remit

# --- Поиск и аналитика ---
# Яндекс.Вебмастер -> Настройки -> Права доступа (значение мета-тега)
REMIT_YANDEX_VERIFICATION=
# Google Search Console -> Способ с HTML-тегом (значение content)
REMIT_GOOGLE_VERIFICATION=
# Номер счётчика Яндекс.Метрики; пусто — счётчик не подключается
REMIT_YANDEX_METRIKA_ID=

# --- Пробный период для компаний ---
REMIT_TRIAL_MAX_DAYS=30
REMIT_TRIAL_DEFAULT_DAYS=14
REMIT_TRIAL_PLAN=pro

# --- Уведомления о заявках ---
# Бот создаётся у @BotFather, chat_id узнаётся через @userinfobot
REMIT_TELEGRAM_BOT_TOKEN=
REMIT_TELEGRAM_CHAT_ID=

# --- Админка ---
# Почты, которым админка доступна всегда (через запятую). Нужны, чтобы войти
# в неё сразу после установки; дальше роли выдаются из самой админки.
REMIT_ADMIN_EMAILS=

# --- Вход через VK ID ---
# ID приложения из кабинета VK ID (id.vk.com/about/business). Адрес возврата
# в настройках приложения: https://<ваш домен>/api/v1/auth/vk/callback.
# Пусто — кнопки «VK ID» на сайте и в клиенте не показываются.
REMIT_VK_CLIENT_ID=

# --- Секреты (сгенерируйте: openssl rand -hex 32) ---
REMIT_AUTH_SECRET=
REMIT_SERVICE_TOKEN=
# Подпись токенов входа в клиенте; этот же ключ получает hbbs.
JWT_KEY=

# --- Хранилище сборок клиента ---
# Каталог, куда админка складывает загруженные файлы обновлений
REMIT_RELEASES_DIR=/app/data/releases
# Предел размера одного файла (по умолчанию 1 ГБ)
REMIT_MAX_UPLOAD_BYTES=1073741824
# Необязательно: внешнее хранилище, если сборки лежат не на сервере
REMIT_DOWNLOADS_BASE=

# --- Снимки экрана к обращениям в поддержку ---
# Каталог с файлами: их видят только автор обращения и поддержка
REMIT_ATTACHMENTS_DIR=/app/data/attachments
# Предел размера одного снимка (по умолчанию 10 МБ)
REMIT_MAX_ATTACHMENT_BYTES=10485760
# Сколько файлов принимаем к одному обращению
REMIT_MAX_ATTACHMENTS=5

# --- База данных ---
POSTGRES_DB=remit
POSTGRES_USER=remit
POSTGRES_PASSWORD=
DATABASE_URL=postgres://remit:пароль@db:5432/remit

# --- Тарификация ---
# 3 часа в сутки = 10800 секунд
REMIT_FREE_SECONDS_PER_DAY=10800
REMIT_TZ=Europe/Moscow

# --- RustDesk ---
# Образ hbbs + hbbr. По умолчанию — стоковый, без проверки суточного лимита и
# токенов входа. Свой образ: sudo bash server/build-image.sh (см. docs/DEPLOY.md)
# или ghcr.io/anathom1a/rustdesk-server-s6-remit:latest из GitHub Actions.
RUSTDESK_IMAGE=rustdesk/rustdesk-server-s6:latest
# Y — соединяться могут только клиенты, вошедшие в аккаунт (нужен свой образ).
MUST_LOGIN=N
# Срок входа в клиенте, секунды (30 дней). Потом клиент попросит войти заново.
REMIT_CLIENT_TOKEN_TTL=2592000

# --- Оплата: ЮKassa ---
# yookassa — приём карт и СБП; manual — резервный режим (счёт подтверждает администратор)
REMIT_BILLING_PROVIDER=yookassa
# Личный кабинет ЮKassa -> Интеграция -> Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa возвращает клиента после оплаты
YOOKASSA_RETURN_URL=https://remit.su/kabinet/podpiska
# В ЮKassa (Интеграция -> HTTP-уведомления) укажите:
#   https://remit.su/api/v1/billing/webhook/yookassa
# и включите события payment.succeeded и payment.canceled
